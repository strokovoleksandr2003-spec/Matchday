PORT=4000

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# the SERVICE ROLE key, not the anon/public one — this app talks to
# Supabase only from the server/function, never from the browser
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Shared secret for the admin form (/admin.html) and admin API
# (/api/admin/*). Pick any long random string.
ADMIN_TOKEN=change_me_to_something_long_and_random
