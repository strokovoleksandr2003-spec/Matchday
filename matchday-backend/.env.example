PORT=4000

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# the SERVICE ROLE key, not the anon/public one — this app talks to
# Supabase only from the server/function, never from the browser
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Shared secret for the admin form (/admin.html) and admin API
# (/api/admin/*). Pick any long random string.
ADMIN_TOKEN=change_me_to_something_long_and_random

# --- automatic fixture sync (optional) --------------------------------
# API-Football key. Without this, the app still works — you just enter
# results by hand in /admin.html.
#
# Two ways to get one, and the HOST below must match which you used:
#   dashboard.api-football.com  →  host v3.football.api-sports.io  (default)
#   rapidapi.com                →  host api-football-v1.p.rapidapi.com
# Mixing them up returns 403.
API_FOOTBALL_KEY=your_api_football_key_here
API_FOOTBALL_HOST=v3.football.api-sports.io
# UPL is league 333. Change only if you add another competition.
API_FOOTBALL_LEAGUE_ID=333
# Season the API should be queried for, as a year. Defaults to the
# current calendar year if unset.
API_FOOTBALL_SEASON=2026
